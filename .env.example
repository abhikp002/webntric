# ==============================================================================
# Webntric Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Gmail SMTP Configuration for Contact Form
# ------------------------------------------------------------------------------
# Default sender & recipient email
GMAIL_USER=info@webntric.com

# 16-character Google App Password generated from your Google Account:
# 1. Sign in to your Google Account (for info@webntric.com)
# 2. Go to Security > 2-Step Verification (must be enabled)
# 3. Scroll to "App passwords" (or search "App passwords" in Google Account)
# 4. Create a new App Password with name "Webntric Website"
# 5. Copy the generated 16-character code (spaces can be omitted) and paste here:
GMAIL_APP_PASSWORD=your-16-character-app-password

# Optional: recipient override (defaults to info@webntric.com if omitted)
CONTACT_RECIPIENT_EMAIL=info@webntric.com

# Optional SMTP server configuration (defaults to smtp.gmail.com:465 SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Optional: External webhook forwarding (e.g. Zapier, Make, Slack incoming webhook)
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...
